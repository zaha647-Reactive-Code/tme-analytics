# ─────────────────────────────────────────────────────────────
# TME Analytics Hub — environment settings
# Copy this file to ".env.local" and fill in the values.
# ─────────────────────────────────────────────────────────────

# "demo" = sample data (default)   |   "ga4" = live Google Analytics 4 data
ANALYTICS_MODE=demo

# Default GA4 *Property ID* (numbers only, e.g. 412345678).
# Found in GA4 → Admin → Property details. Used for any dashboard in
# src/config/dashboards.ts that does not set its own ga4PropertyId.
GA4_PROPERTY_ID=

# Google Cloud service account that has "Viewer" access on the GA4 property.
GOOGLE_CLIENT_EMAIL=
# Paste the private key in one line, keeping the \n characters.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Analytics 4 Measurement ID (starts with G-)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-VHZNXTMVES
